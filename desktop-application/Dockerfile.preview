FROM node:22-bookworm-slim AS frontend
WORKDIR /frontend
COPY frontend/package.json frontend/package-lock.json ./
RUN --mount=type=cache,target=/root/.npm npm ci
COPY frontend/index.html frontend/vite.config.ts frontend/tsconfig*.json ./
COPY frontend/src ./src
COPY frontend/public ./public
RUN npm run build

FROM ghcr.io/astral-sh/uv:0.13.9 AS uv
FROM python:3.11-slim-bookworm AS dependencies
WORKDIR /app
COPY --from=uv /uv /usr/local/bin/uv
COPY backend/pyproject.toml backend/uv.lock backend/README.md ./
RUN --mount=type=cache,id=sheetmind-desktop-preview-uv,target=/root/.cache/uv \
    uv sync --frozen --offline --no-dev --no-install-project --no-python-downloads \
    || uv sync --frozen --no-dev --no-install-project --no-python-downloads

FROM python:3.11-slim-bookworm
ENV PATH="/app/.venv/bin:$PATH" PYTHONDONTWRITEBYTECODE=1 PYTHONUNBUFFERED=1 \
    SHEETMIND_DATA_DIR=/var/lib/sheetmind MPLCONFIGDIR=/var/lib/sheetmind/matplotlib
WORKDIR /app
RUN groupadd --gid 10001 sheetmind && useradd --uid 10001 --gid sheetmind --create-home sheetmind \
    && install -d -o sheetmind -g sheetmind /var/lib/sheetmind
COPY --from=dependencies /app/.venv /app/.venv
COPY backend/main.py backend/dependencies.py backend/preview.py ./
COPY backend/models ./models
COPY backend/routers ./routers
COPY backend/schemas ./schemas
COPY backend/services ./services
COPY --from=frontend /frontend/dist /app/frontend-dist
USER sheetmind
CMD ["python", "-B", "preview.py"]
