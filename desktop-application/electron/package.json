{
    "name": "sheetmind",
    "version": "1.0.0",
    "description": "SheetMind - AI-powered excel and data companion",
    "main": "main.js",
    "scripts": {
        "start": "electron .",
        "pack": "electron-builder --dir",
        "dist": "electron-builder"
    },
    "devDependencies": {
        "electron": "^30.0.0",
        "electron-builder": "^24.13.3",
        "electron-devtools-installer": "^4.0.0"
    },
    "build": {
        "appId": "com.sheetmind.app",
        "productName": "SheetMind",
        "win": {
            "target": "nsis",
            "artifactName": "SheetMind-${version}-windows-${arch}-setup.${ext}",
            "icon": "assets/icon.ico"
        },
        "mac": {
            "target": "dmg",
            "icon": "assets/icon.png"
        },
        "linux": {
            "target": "AppImage",
            "artifactName": "SheetMind-${version}-linux-${arch}.${ext}",
            "icon": "assets/icon.png"
        },
        "nsis": {
            "oneClick": true,
            "allowToChangeInstallationDirectory": false,
            "createDesktopShortcut": true,
            "createStartMenuShortcut": true,
            "shortcutName": "SheetMind"
        },
        "extraResources": [
            {
                "from": "../build/backend",
                "to": "backend",
                "filter": ["sheetmind-backend", "sheetmind-backend.exe"]
            },
            {
                "from": "../build/frontend",
                "to": "frontend"
            }
        ],
        "files": [
            "main.js",
            "preload.js",
            "assets/**/*"
        ]
    }
}
